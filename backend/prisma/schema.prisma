generator client {
    provider = "prisma-client-js"
    moduleFormat = "esm"
}

datasource db {
    provider = "postgresql"
    url = env("DB_URL")
}

model Task {
    id          Int      @id @default(autoincrement())
    title       String
    description String?
    column      Column   @relation(fields: [columnId], references: [id])
    columnId    Int
    orderId     Float
    images      TaskImage[]
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([orderId, columnId])
}

model Column {
    id        Int      @id @default(autoincrement())
    name      String   @unique
    tasks     Task[]
    color     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model TaskImage {
    id        Int      @id @default(autoincrement())
    filename  String
    task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
    taskId    Int
    createdAt DateTime @default(now())

    @@index([taskId])
}
