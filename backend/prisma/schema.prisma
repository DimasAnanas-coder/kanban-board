generator client {
    provider = "prisma-client-js"
    moduleFormat = "esm"
}

datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL")
}

model Task {
    id          Int      @id @default(autoincrement())
    title       String
    description String?
    columnName  String   @default("TODO")
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}